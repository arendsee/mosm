module (convertCommand)

import .lib.mosm


--' Convert FASTA format to a new form
--' @name convert
convertCommand ::
  --' Fasta file
  --' @check.path r
  --' @stdin
  Str -> <IO> ()
convertCommand fastafile = do
  o <- @stdout :: <IO> (OStream (Seq Str))
  streamSeq fastafile (sink 3 o)
  @close o

source Cpp from "src/formats.hpp" ("streamSeq")

streamSeq :: Str -> ([Seq Str] -> <IO> ()) -> <IO> ()
