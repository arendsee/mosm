module (filterCommand)

import .lib.mosm
import maybe-cpp (isNull, require)

--' @unroll
record FilterOpts where
  --' keep only if length is greater than or equal to LEN
  --' @metavar LEN
  --' @arg -l/--longer-than
  --' @default null
  longerThan :: ?U64

  --' keep only if length is less than or equal to LEN
  --' @metavar LEN
  --' @arg -s/--shorter-than
  --' @default null
  shorterThan :: ?U64

  --' keep only if composition meets condition (e.g., 'GC > .5')
  --' @metavar EXPR
  --' @arg -c/--composition
  --' @default ""
  composition :: Str

  --' worker threads for the per-sequence tests; 0 means one per core
  --' @metavar N
  --' @arg -t/--threads
  --' @default 0
  threads :: Int

record Cpp => FilterOpts = "struct"

-- Accept a leading-dot ratio like `.5` by prefixing a zero (`0.5`); morloc's
-- number syntax (and @read) require a digit before the decimal point.
normalizeLeadingDot :: Str -> Str
normalizeLeadingDot x = ? startsWith "." x = join "" ["0", x] : x

-- Parse and validate a composition rule into plain data (chars,
-- comparator, limit). Returning data rather than a predicate keeps the
-- callable out of the Try, so it can be rebuilt purely at the call site.
parseComposition :: Str -> Try Str CompRule
parseComposition compStr =
  let s = split " " compStr
  in ? size s != 3 = Err "Expected composition rule with exactly three pieces (e.g., 'GC < 0.5')"
     : match (@read (normalizeLeadingDot (.[2] s)) :: Try Str Real)
         | (Err e) = Err e
         | (Ok limit) =
             ? limit > 1.0 = Err "Expected ratio <= 1"
             ? limit < 0.0 = Err "Expected ratio >= 0"
             ? not (elem (.[1] s) ["<", ">", ">=", "<="]) = Err "Illegal comparator #{.[1] s}"
             : Ok (str2u8 (.[0] s), .[1] s, limit)

--' A parsed composition rule: the characters counted, the comparator, and
--' the limit on their fraction.
type CompRule = (Vector U8, Str, Real)

-- The rule for a `-c` argument. An absent rule (the empty string) becomes the
-- rule "no characters, fraction <= 1", which every sequence satisfies, so the
-- predicate needs no special case. A malformed rule aborts here, once.
compRule :: Str -> CompRule
compRule s ? s == "" = (str2u8 "", "<=", 1.0)
           : unwrap (parseComposition s)

-- Pure: test one sequence against a parsed rule.
compPredicate :: CompRule -> Vector U8 -> Bool
compPredicate (chars, op, limit) seq =
  let cmap = charCount seq
      fraction = toReal (fold (\b c -> b + .[c] cmap) 0 chars) / toReal (size seq)
  in ? op == "<"  = fraction <  limit
     ? op == ">"  = fraction >  limit
     ? op == ">=" = fraction >= limit
     ? op == "<=" = fraction <= limit
     : False

--' extracts sequences meeting the given conditions
--'
--' Prints every entry by default. Multiple conditions may be selected.
--'
--' $ mosm filter -s 200 -l 100 -c 'GC > .5'
--'
--' Prints sequences with length of 100-200 and GC content >50%.
--'
--' @name filter
--' @render -f/--fasta=toFastaEntries @stream @default
filterCommand :: FilterOpts -> RFile -> <IO> ()
filterCommand opts file = do
  Ok fi <- @open file :: <IO> (Try Str (IStream (Seq Str)))

  -- Parsed once here. Work placed inside a let-bound lambda is redone on
  -- every call, and the predicate runs once per sequence.
  let rule = compRule (.composition opts)

  let ltf = ? isNull (.longerThan opts) = const True
            : let limit = require (.longerThan opts)
              in (\seq -> size seq > limit)

  let stf = ? isNull (.shorterThan opts) = const True
            : let limit = require (.shorterThan opts)
              in (\seq -> size seq < limit)

  let f = (\(_, s) -> ltf s && stf s && compPredicate rule s)

  @collect (filterSeqs (parOpts (.threads opts)) f fi)

-- The @collect producer, at the concrete element type: a streaming command's
-- batch type is read off the producer's signature. Each batch is filtered
-- in parallel; `batch` times each parallel call.
filterSeqs :: ParOpts -> (Seq Str -> Bool) -> IStream (Seq Str) -> ([Seq Str] -> <IO> ()) -> <IO> ()
filterSeqs opts p fi = psbatch (batch@pfilterWith opts p) (pull fi)
