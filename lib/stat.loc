module (statsCommand, cstatsCommand)

import .lib.mosm


--' @unroll
record StatsOpts where

  --' Case sensitive
  --' @true -I/--case-sensitive
  caseSensitive :: Bool

record Cpp => StatsOpts = "struct"

source Cpp from "src/stat.hpp"
  ( "charHist"
  , "addHist"
  , "caseInsensitive"
  , "psmap"
  , "statsProfile"
  , "statsHist"
  , "statsLogHist"
  , "statsProportion"
  , "statsCountTable"
  , "statsSummary"
  , "cstatsSummary"
  )

-- helpers
charHist :: Vector U8 -> Vector 256 U64
addHist :: Vector n U64 -> Vector n U64 -> Vector n U64
caseInsensitive :: Vector 256 U64 -> Vector 256 U64

-- Map each read of a stream through `f`, forwarding results to a sink. The pull
-- loop lives in C++; morloc supplies `f` and the `@next`/sink callbacks.
psmap
  :: (a -> b)
  -> <IO> [a]
  -> ([b] -> <IO> ())
  -> <IO> ()
 


--' display protein profile
statsProfile :: [Vector 256 U64] -> <IO> ()

--' write proportion of each character
statsProportion :: [Vector 256 U64] -> <IO> ()

--' write a table of character counts
statsCountTable :: [Vector 256 U64] -> <IO> ()

--' write 5 number summary of lengths
cstatsSummary :: [Vector 256 U64] -> <IO> ()

-- One byte histogram per sequence. Two variants selected by -I; both carry an
-- explicit signature so the collected element type resolves concretely.
seqHist :: Seq Str -> Vector 256 U64
seqHist (_, seq) = charHist seq

seqHistCI :: Seq Str -> Vector 256 U64
seqHistCI (_, seq) = caseInsensitive (charHist seq)

-- Collect one byte histogram per sequence, folding case unless -I is given.
--
--' calculate character-composition statistics
--' @name cstat
--' @render -C/--profile=statsProfile
--' @render -p/--proportion=statsProportion
--' @render -c/--counts=statsCountTable
--' @render -s/--summary=cstatsSummary @default
cstatsCommand :: StatsOpts -> RFile -> <IO> ()
cstatsCommand opt file = do
  Ok fi <- @open file :: <IO> (Try Str (IStream (Seq Str)))
  let toHist = ? .caseSensitive opt = seqHist
               : seqHistCI
  @collect (histSeqs toHist fi)

-- The @collect producers, at concrete element types. A streaming command's
-- batch type is read off the producer's signature, so the generic psmap
-- cannot sit at the head of the @collect argument.
histSeqs :: (Seq Str -> Vector 256 U64) -> IStream (Seq Str) -> ([Vector 256 U64] -> <IO> ()) -> <IO> ()
histSeqs f fi = psmap f (pull fi)

lengthSeqs :: (Seq Str -> (Str, U64)) -> IStream (Seq Str) -> ([(Str, U64)] -> <IO> ()) -> <IO> ()
lengthSeqs f fi = psmap f (pull fi)


--' write 5 number summary of lengths
statsSummary :: [(Str, U64)] -> <IO> ()

--' write ascii histogram of sequence lengths
statsHist :: [(Str, U64)] -> <IO> ()

--' write ascii histogram of sequence log2 lengths
statsLogHist :: [(Str, U64)] -> <IO> ()

-- One (header, length) pair per sequence. The explicit signature pins the
-- collected element type so it serializes concretely.
seqLength :: Seq Str -> (Str, U64)
seqLength (name, seq) = (name, size seq)

-- Collect one (header, length) pair per sequence. Case sensitivity does not
-- affect lengths, so StatsOpts is ignored here.
--
--' calculate sequence-length statistics
--' @name stat
--' @render -g/--hist=statsHist
--' @render -G/--log-hist=statsLogHist
--' @render -s/--summary=statsSummary @default
statsCommand :: StatsOpts -> RFile -> <IO> ()
statsCommand _ file = do
  Ok fi <- @open file :: <IO> (Try Str (IStream (Seq Str)))
  @collect (lengthSeqs seqLength fi)
